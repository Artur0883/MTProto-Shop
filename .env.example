# ============== Telegram ==============
BOT_TOKEN=
SUPPORT_BOT_TOKEN=
ADMIN_ID=

# ============== Публичный адрес прокси ==============
SERVER_HOST=
PROXY_PORT=443

# ============== TLS-маскировка (обход DPI / РКН) ==============
# Основной домен, который виден РКН как назначение трафика.
# Должен быть реальным сайтом с TLS 1.3 на 443.
TLS_DOMAIN=petrovich.ru

# Резервные домены через запятую. Если основной заблокирован у конкретного
# оператора — бот предложит клиенту вариант через любой из этих.
# Рекомендации:
#   * добавьте 2-3 разных по тематике домена (не однотипные «магазины»)
#   * проверяйте их через openssl s_client (или mtp -> 25)
#   * избегайте доменов, заведомо популярных у других MTProto-сервисов
TLS_DOMAINS=www.cloudflare.com,www.bing.com

# ============== TeleMT API (внутри docker-сети) ==============
PROXY_CORE=telemt
TELEMT_API_URL=http://mtproto:9091
TELEMT_SYSTEM_USER=shop_bootstrap

# Тонкая настройка отказоустойчивости (трогать только при необходимости)
TELEMT_API_TIMEOUT=5.0
TELEMT_API_MAX_RETRIES=3
TELEMT_CIRCUIT_BREAKER_THRESHOLD=5
TELEMT_CIRCUIT_BREAKER_RECOVERY=30.0
TELEMT_ROTATE_COOLDOWN=30.0

# ============== UX / Поддержка ==============
SUPPORT_CONTACT=
DATABASE_PATH=/app/data/shop.db

# ============== Платежи ==============
PAYMENT_MODE=manual
DEV_AUTO_ISSUE=false
PAYMENTS_ENABLED=true

# ============== Логирование ==============
# json — для production (контейнерные логи), console — для локальной разработки
LOG_LEVEL=INFO
LOG_FORMAT=json
