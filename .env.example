# ============== Telegram ==============
BOT_TOKEN=
SUPPORT_BOT_TOKEN=
ADMIN_ID=

# ============== Публичный адрес прокси ==============
SERVER_HOST=
PROXY_PORT=443

# ============== TLS-маскировка (обход DPI / РКН) ==============
# Основной домен, который виден РКН как назначение трафика.
# Должен быть реальным сайтом с TLS 1.3 на 443.
TLS_DOMAIN=www.microsoft.com

# Резервные домены через запятую. Если основной заблокирован у конкретного
# оператора — бот предложит клиенту вариант через любой из этих.
# Рекомендации:
#   * добавьте 2-3 разных по тематике домена (не однотипные «магазины»)
#   * проверяйте их через openssl s_client (или mtp -> 25)
#   * избегайте доменов, заведомо популярных у других MTProto-сервисов
TLS_DOMAINS=www.cloudflare.com,www.apple.com,www.bing.com

# ============== TeleMT API (внутри docker-сети) ==============
PROXY_CORE=telemt
TELEMT_API_URL=http://mtproto:9091
TELEMT_SYSTEM_USER=shop_bootstrap
TELEMT_PROXY_INTERNAL_PORT=443

# Тонкая настройка отказоустойчивости (трогать только при необходимости)
TELEMT_API_TIMEOUT=5.0
TELEMT_API_MAX_RETRIES=3
TELEMT_CIRCUIT_BREAKER_THRESHOLD=5
TELEMT_CIRCUIT_BREAKER_RECOVERY=30.0
TELEMT_ROTATE_COOLDOWN=30.0

# ============== UX / Поддержка ==============
SUPPORT_CONTACT=
DATABASE_PATH=/app/data/shop.db

# ============== Платежи ==============
PAYMENT_MODE=manual
DEV_AUTO_ISSUE=false
PAYMENTS_ENABLED=true

# ============== Логирование ==============
# json — для production (контейнерные логи), console — для локальной разработки
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============== Внешний мониторинг (необязательно) ==============
# «Мёртвый выключатель»: бот раз в ~30 сек пингует этот URL, пока жив и видит
# Telegram. Если пинги прекратились (упала вся VPS / docker / сеть) — внешний
# сервис пришлёт вам уведомление. Бесплатно: healthchecks.io (создайте Check и
# вставьте сюда его Ping URL). Оставьте пустым, чтобы выключить.
HEALTHCHECK_PING_URL=
BOT_HEALTHCHECK_MAX_AGE=180
SUPPORT_BOT_HEALTHCHECK_MAX_AGE=180
# ============== Само-лечение прокси (необязательно, по умолчанию включено) ==============
# Бот сам следит за маскировочными доменами и при блокировке переключает выдачу
# ссылок на здоровый домен. Трогать не обязательно.
SELF_HEAL_ENABLED=true
SELF_HEAL_CHECK_INTERVAL=120
SELF_HEAL_SWITCH_COOLDOWN=600
SELF_HEAL_MAX_SWITCHES_PER_DAY=6

# ============== Второй сервер / мультиузел (необязательно) ==============
# Несколько прокси-серверов. Если не задано — работает один сервер, как сейчас.
# Раскомментируйте и впишите оба сервера, чтобы бот заводил клиентов на оба и
# выдавал ДВЕ ссылки (если один IP заблокируют — клиент идёт через второй).
# PROXY_NODES=[{"name":"RU-1","public_host":"31.76.77.226","api_url":"http://mtproto:9091","primary":true},{"name":"EU-2","public_host":"2.26.55.53","api_url":"http://100.87.48.113:9091","primary":false}]
# RECONCILE_INTERVAL=300
